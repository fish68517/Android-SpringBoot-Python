<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <!-- Title -->
    <TextView
        android:id="@+id/browse_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/browse"
        android:textSize="@dimen/text_size_title_medium"
        android:textStyle="bold"
        android:textColor="@color/md_theme_on_background"
        android:padding="@dimen/spacing_md"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Horizontal Layout: Filters on left, Books on right -->
    <ScrollView
        android:id="@+id/filter_scroll_view"
        android:layout_width="200dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/browse_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/books_recycler_view">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_sm">

            <!-- Condition Filter Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="书籍状况"
                android:textSize="@dimen/text_size_body_small"
                android:textStyle="bold"
                android:textColor="@color/md_theme_on_background"
                android:paddingTop="@dimen/spacing_sm" />

            <!-- Condition Chips -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/condition_chip_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_xs"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_all_conditions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="全部"
                    android:checked="true"
                    app:chipBackgroundColor="@color/md_theme_secondary"
                    app:chipStrokeColor="@color/md_theme_secondary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_new"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="全新"
                    app:chipBackgroundColor="@color/md_theme_secondary"
                    app:chipStrokeColor="@color/md_theme_secondary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_like_new"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="如新"
                    app:chipBackgroundColor="@color/md_theme_secondary"
                    app:chipStrokeColor="@color/md_theme_secondary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_good"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="良好"
                    app:chipBackgroundColor="@color/md_theme_secondary"
                    app:chipStrokeColor="@color/md_theme_secondary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_fair"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="一般"
                    app:chipBackgroundColor="@color/md_theme_secondary"
                    app:chipStrokeColor="@color/md_theme_secondary" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Sort Label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="排序方式"
                android:textSize="@dimen/text_size_body_small"
                android:textStyle="bold"
                android:textColor="@color/md_theme_on_background"
                android:paddingTop="@dimen/spacing_sm" />

            <!-- Sort Chips -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/sort_chip_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_xs"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_newest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="最新"
                    android:checked="true"
                    app:chipBackgroundColor="@color/md_theme_tertiary"
                    app:chipStrokeColor="@color/md_theme_tertiary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_price_asc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="价格低到高"
                    app:chipBackgroundColor="@color/md_theme_tertiary"
                    app:chipStrokeColor="@color/md_theme_tertiary" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_price_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="价格高到低"
                    app:chipBackgroundColor="@color/md_theme_tertiary"
                    app:chipStrokeColor="@color/md_theme_tertiary" />

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>

    </ScrollView>

    <!-- Books RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/books_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="@dimen/spacing_sm"
        app:layout_constraintTop_toBottomOf="@id/browse_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/filter_scroll_view"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/loading_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/books_recycler_view"
        app:layout_constraintBottom_toBottomOf="@id/books_recycler_view"
        app:layout_constraintStart_toStartOf="@id/books_recycler_view"
        app:layout_constraintEnd_toEndOf="@id/books_recycler_view" />

</androidx.constraintlayout.widget.ConstraintLayout>
