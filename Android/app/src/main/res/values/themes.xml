<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material Design 3 Theme -->
    <style name="Theme.CampusBookTrading" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary color (Blue) -->
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorPrimaryVariant">@color/md_theme_primary_variant</item>
        <item name="colorOnPrimary">@color/md_theme_on_primary</item>

        <!-- Secondary color (Teal) -->
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorSecondaryVariant">@color/md_theme_secondary_variant</item>
        <item name="colorOnSecondary">@color/md_theme_on_secondary</item>

        <!-- Tertiary color (Orange) -->
        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_on_tertiary</item>

        <!-- Background and surface -->
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_on_surface</item>

        <!-- Error color -->
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_on_error</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/md_theme_on_background</item>
        <item name="android:textColorSecondary">@color/md_theme_on_surface</item>
    </style>

    <!-- No Action Bar variant -->
    <style name="Theme.CampusBookTrading.NoActionBar" parent="Theme.CampusBookTrading">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
    </style>

</resources>
