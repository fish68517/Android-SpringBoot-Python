<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.amap.api.maps.MapView
        android:id="@+id/map_view_geofence"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:visibility="gone"
        android:id="@+id/search_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#99FFFFFF"
        android:elevation="4dp">

        <EditText
            android:id="@+id/et_location_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="输入教室位置搜索"
            android:inputType="text"
            android:maxLines="1" />

        <Button
            android:id="@+id/btn_location_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="搜索" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#99FFFFFF"
        android:elevation="4dp">

        <Button
            android:id="@+id/btn_clear_polygon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="清除重选"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_confirm_geofence"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="确认围栏" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_instruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="请点击地图设置教室多边形（至少3个点）"
        android:layout_below="@id/search_bar_layout"
        android:background="#80000000"
        android:textColor="@android:color/white"
        android:padding="4dp"
        android:layout_centerHorizontal="true"/>

</RelativeLayout>