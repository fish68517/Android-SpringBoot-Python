<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <!-- Top App Bar (MaterialToolbar + SearchView) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/app_bar_with_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="false"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/topAppBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:title="@string/app_name"
                app:titleCentered="true" />

            <androidx.appcompat.widget.SearchView
                android:visibility="gone"
                android:id="@+id/search_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:iconifiedByDefault="false"
                android:queryHint="@string/search"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Main Content ScrollView -->
    <ScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/app_bar_with_search"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Featured Books Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/featured_books"
                android:textSize="@dimen/text_size_title_large"
                android:textStyle="bold"
                android:textColor="@color/md_theme_on_background"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <!-- Featured Books Carousel -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/featured_books_carousel"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_lg"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Recent Books Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recent_books"
                android:textSize="@dimen/text_size_title_large"
                android:textStyle="bold"
                android:textColor="@color/md_theme_on_background"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <!-- Recent Books Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recent_books_grid"
                android:layout_width="match_parent"
                android:layout_height="@dimen/book_grid_height"
                android:layout_marginBottom="@dimen/spacing_md"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/bottom_navigation_menu"

        app:labelVisibilityMode="labeled"
        android:background="@color/md_theme_surface"
        app:itemIconTint="@color/md_theme_primary"
        app:itemTextColor="@color/md_theme_primary" />

</androidx.constraintlayout.widget.ConstraintLayout>
