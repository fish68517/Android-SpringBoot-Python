<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/book_card"
    android:layout_width="match_parent"
    android:layout_height="280dp"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/md_theme_primary"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Book Image -->
        <ImageView
            android:id="@+id/book_image"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/book_detail" />

        <!-- Book Title -->
        <TextView
            android:id="@+id/book_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Book Title"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_on_surface"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="6dp" />

        <!-- Book Author -->
        <TextView
            android:id="@+id/book_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Author"
            android:textSize="11sp"
            android:textColor="@color/gray_medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <!-- Book Price -->
        <TextView
            android:id="@+id/book_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¥0.00"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_primary"
            android:layout_marginTop="6dp" />

        <!-- Book Condition -->
        <com.google.android.material.chip.Chip
            android:id="@+id/book_condition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Good"
            android:textSize="10sp"
            android:layout_marginTop="4dp"
            app:chipBackgroundColor="@color/md_theme_secondary"
            app:chipStrokeColor="@color/md_theme_secondary"
            app:textStartPadding="4dp"
            app:textEndPadding="4dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
